{
  "hosting": {
    "public": ".",
    "ignore": [
      ".firebase/**",
      "**/.git/**",
      ".git/**",
      "firebase.json",
      "firestore.waitlist.rules",
      "trailer_left.mp4",
      "trailer_right.mp4",
      ".claude/**",
      "**/.claude/**",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      }
    ]
  }
}
